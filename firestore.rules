rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow anyone to read character documents, but restrict writes to admins
    match /characters/{characterId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    // Allow anyone to read popularCharacters, but restrict writes to admins
    match /popularCharacters/{characterId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    // Default rule: deny all other writes
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
