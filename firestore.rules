rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow anyone to read character documents, but restrict writes to admins
    match /characters/{characterId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    // Allow anyone to read popularCharacters, but restrict writes to admins
    match /popularCharacters/{characterId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    // Community server directory (Game Hub -> Server Hub). Signed-in users
    // may register servers they own; only the uploader can edit/remove them.
    // NOTE: rules deploy from the backend repo, not this one — mirror this
    // block there before shipping the Server Hub.
    match /hostedServers/{serverId} {
      allow read: if true;
      allow create: if request.auth != null &&
        request.resource.data.uploaderId == request.auth.uid;
      allow update, delete: if request.auth != null &&
        resource.data.uploaderId == request.auth.uid;
    }
    // Default rule: deny all other writes
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
